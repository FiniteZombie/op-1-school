# Supply-chain guardrails. See "Dependencies" in AGENTS.md.
# Never run package install scripts (the main way a bad package runs code here).
ignore-scripts=true
# Record exact versions in package.json.
save-exact=true
# Skip versions published in the last 7 days; most bad releases are caught by then.
min-release-age=7
# No dependencies pulled straight from git repos.
allow-git=none
